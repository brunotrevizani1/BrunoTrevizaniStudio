# Copie este arquivo para ".env" e preencha com a connection string do seu projeto Neon.
# Console do Neon: Project > Connection Details > Connection string (use a "pooled connection").
# IMPORTANT: sem prefixo VITE_ — essa variável só é lida pelas funções serverless em /api,
# nunca deve ir pro bundle do client.

DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require
